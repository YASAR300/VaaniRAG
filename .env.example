# ─── Sarvam AI (STT — Saarika v3) ───────────────────────────────────────────
# Server-side only. Never expose in NEXT_PUBLIC_ vars or client components.
# Get your key at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Groq (LLM — llama-3.3-70b for grounded answer generation) ───────────────
# Server-side only.
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ─── Qdrant (vector DB for MSMARCO-XI embeddings) ─────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=msmarco_xi

# ─── Embedding Provider ────────────────────────────────────────────────────────
EMBEDDING_API_KEY=your_embedding_provider_key_here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=VaaniRAG

# ─── Developer Observability Dashboard (Private Gate) ─────────────────────────
DEV_DASHBOARD_SECRET=your_dev_dashboard_secret_here
